{
  "entities": {
    "users": {
      "title": "Passenger and Driver Profiles",
      "description": "User account information and role details",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["PASSENGER", "DRIVER"] },
        "city": { "type": "string" },
        "vehicleModel": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "name", "phone", "role"]
    },
    "bookings": {
      "title": "Travel Bookings",
      "description": "Local and intercity trip bookings across Haryana",
      "properties": {
        "id": { "type": "string" },
        "passengerId": { "type": "string" },
        "passengerName": { "type": "string" },
        "passengerPhone": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "vehicleType": { "type": "string" },
        "vehicleModel": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "destination": { "type": "string" },
        "tripType": { "type": "string", "enum": ["LOCAL", "INTERCITY"] },
        "travelDate": { "type": "string" },
        "travelTime": { "type": "string" },
        "passengerCount": { "type": "integer" },
        "fareAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "COMPLETED", "CANCELLED"] },
        "otp": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "passengerId", "pickupLocation", "destination", "tripType", "travelDate", "travelTime", "passengerCount", "fareAmount", "status"]
    }
  }
